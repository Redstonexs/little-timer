#include <windows.h>

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 0,0,3,0
PRODUCTVERSION 0,0,3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Little Timer - portable speech timer\0"
            VALUE "FileVersion", "0.0.3\0"
            VALUE "InternalName", "LittleTimer\0"
            VALUE "OriginalFilename", "LittleTimer.exe\0"
            VALUE "ProductName", "Little Timer\0"
            VALUE "ProductVersion", "0.0.3\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
